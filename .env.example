PORT=3000

# Database (MongoDB)
DATABASE_URI=mongodb://localhost:27017/nest-mq

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=indication.exchange
RABBITMQ_ROUTING_KEY=customer.indicated
RABBITMQ_QUEUE=customers_queue

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
